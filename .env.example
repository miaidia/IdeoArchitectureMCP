# Example environment for the Plot Analyzer — copy to .env and fill real values.
# NEVER commit a real .env (it is git-ignored). No secrets live in code (F-0477/0478).

# --- Application settings (pydantic-settings, env_prefix=PLOT_) ---
PLOT_DATABASE_URL=postgresql+psycopg://plot:plot@localhost:5432/plot
PLOT_REDIS_URL=redis://localhost:6379/0
PLOT_S3_ENDPOINT_URL=http://localhost:9000
PLOT_S3_ACCESS_KEY=change-me
PLOT_S3_SECRET_KEY=change-me
PLOT_S3_BUCKET=plot-artifacts
PLOT_DEV_HOT_RELOAD=false
PLOT_ANALYTICAL_CRS=EPSG:2180

# --- docker-compose service credentials (consumed by infra/docker-compose.yml) ---
POSTGRES_USER=plot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plot
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
