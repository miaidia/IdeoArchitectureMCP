# Example environment for the Plot Analyzer — copy to .env and fill real values.
# NEVER commit a real .env (it is git-ignored). No secrets live in code (F-0477/0478).

# --- Application settings (pydantic-settings, env_prefix=PLOT_) ---
PLOT_DATABASE_URL=postgresql+psycopg://plot:plot@localhost:5432/plot
PLOT_REDIS_URL=redis://localhost:6379/0
PLOT_S3_ENDPOINT_URL=http://localhost:9000
PLOT_S3_ACCESS_KEY=change-me
PLOT_S3_SECRET_KEY=change-me
PLOT_S3_BUCKET=plot-artifacts
PLOT_DEV_HOT_RELOAD=false
PLOT_ANALYTICAL_CRS=EPSG:2180

# --- HTTP API auth (Phase 14B; F-0477/0479/0480) ---
# Comma-separated key:role:tenant triples; role = read | analyst | admin.
# EMPTY means the API accepts no authenticated requests (fail closed).
PLOT_API_KEYS=change-me:admin:local

# --- Upload sandbox caps (F-0491-0493) ---
PLOT_UPLOAD_MAX_BYTES=20971520
PLOT_UPLOAD_MAX_CHARS=1000000
PLOT_UPLOAD_MAX_PAGES=500

# --- Performance (F-0510/0517/0525) ---
PLOT_PARALLEL_FETCH_LIMIT=8
# 0 disables the analysis-level total deadline; >0 = seconds before remaining
# source themes degrade to source_unavailable (explicit unknowns).
PLOT_ANALYSIS_DEADLINE_S=0
PLOT_PERF_QUICK_BUDGET_S=5.0
PLOT_PERF_LAYOUT_BUDGET_S=10.0

# --- docker-compose service credentials (consumed by infra/docker-compose.yml) ---
POSTGRES_USER=plot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plot
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
