{
  "$defs": {
    "IndicatorCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "method": {
          "description": "How the candidate was produced.",
          "enum": [
            "deterministic_regex",
            "llm_candidate"
          ]
        },
        "name": {
          "description": "Canonical indicator name (v2 §8.1.3 set).",
          "enum": [
            "max_intensity",
            "min_intensity",
            "max_height_m",
            "max_kondygnacje",
            "max_coverage_ratio",
            "min_pbc_ratio",
            "parking_per_mieszkanie",
            "parking_per_100m2_uslug",
            "linia_zabudowy",
            "dach_constraints",
            "zabudowa_srodmiejska"
          ]
        },
        "source_fragment": {
          "$ref": "#/$defs/SourceFragment"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Indicator value: number for numeric indicators (ratios as fractions, e.g. PBC 25% -> 0.25), string for linia_zabudowy/dach_constraints, boolean for zabudowa_srodmiejska.",
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "zone_symbol": {
          "description": "Zone symbol the provision applies to, if scoped.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "value",
        "source_fragment",
        "confidence"
      ],
      "title": "IndicatorCandidate",
      "type": "object"
    },
    "SourceFragment": {
      "additionalProperties": false,
      "description": "Verbatim quote from the document backing the indicator (NFR-AUD-002/005). 'start'/'end' are character offsets into the document text; the quote must occur verbatim or the candidate is rejected (hallucination rejection, F-0550).",
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "SourceFragment",
      "type": "object"
    }
  },
  "$id": "https://plot-analyzer/schemas/planning-indicators.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Planning-indicator candidates extracted from an MPZP/POG/WZ document (base_assumptions §29 parser DoD; IMPLEMENTATION_PLAN_V2 §8.1.3). Every candidate requires a verbatim source_fragment citation + confidence — a candidate without verifiable evidence is rejected (F-0550).",
  "items": {
    "$ref": "#/$defs/IndicatorCandidate"
  },
  "title": "PlanningIndicatorCandidates",
  "type": "array"
}
